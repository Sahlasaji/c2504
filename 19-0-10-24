<Grid Margin="0,68,0,0">
    <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <TextBlock Text="EHR Record Management" FontSize="20" FontWeight="Bold" Margin="289,-55,127,74" Grid.ColumnSpan="3"/>

    <Label Grid.Column="0" Grid.Row="0" Content="Patient ID :"/>
    <TextBox Grid.Column="1" Grid.Row="0" x:Name="txtPatientID" Margin="5" Text="{Binding NewEHRRecord.PatientID }"/>

    <Label Grid.Column="0" Grid.Row="1" Content="User  ID :"/>
    <TextBox Grid.Column="1" Grid.Row="1" x:Name="txtUserID" Margin="5" Text="{Binding NewEHRRecord.UserID}"/>

    <Label Grid.Column="0" Grid.Row="2" Content="Record Type :"/>
    <TextBox Grid.Column="1" Grid.Row="2" x:Name="txtRecordType" Margin="5" Text="{Binding NewEHRRecord.RecordType}"/>
    <Label Grid.Column="0" Grid.Row="3" Content="Description :"/>
    <TextBox Grid.Column="1" Grid.Row="3" x:Name="txtDescription" Margin="5" Text="{Binding NewEHRRecord.Description}"/>

    <Label Grid.Column="0" Grid.Row="4" Content="Start Date :"/>
    <DatePicker Grid.Column="1" Grid.Row="4" x:Name="dpStartDate" Margin="5" SelectedDate="{Binding NewEHRRecord.DateOfEntry}"/>

    

    <Button Grid.Column="1" Grid.Row="5" x:Name="btnAdd" Content="Add" Margin="231,27,35,0"  Height="38" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5" Command="{Binding CreateCommand}">
        <Button.RenderTransform>
            <TransformGroup>
                <ScaleTransform ScaleX="1"/>
                <SkewTransform/>
                <RotateTransform/>
                <TranslateTransform/>
            </TransformGroup>
        </Button.RenderTransform>
    </Button>
</Grid>


